{
  "type": "module",
  "version": "0.0.1",
  "description": "A fast URLPattern router",
  "keywords": [
    "router",
    "url-pattern",
    "regexp"
  ],
  "repository": "mapljs/pattern-router",
  "exports": {
    ".": "./index.mjs",
    "./*": "./*.mjs"
  },
  "scripts": {
    "fmt": "oxfmt",
    "test": "node --test tests/**/*.test.mts",
    "push-release": "bun scripts/src/push-release.mts",
    "build": "bun scripts/src/build.mts",
    "pkg-stats": "bun scripts/src/pkg-stats.mts",
    "setup": "bun scripts/src/setup.mts",
    "snap": "bun scripts/src/snap.mts"
  },
  "devDependencies": {
    "@types/node": "^26.4.0",
    "oxc-minify": "^0.154.0",
    "oxc-transform": "^0.154.0",
    "oxfmt": "^0.73.0",
    "picocolors": "^1.1.1",
    "tinyglobby": "^0.2.17",
    "typescript": "^7.0.2"
  },
  "sideEffects": false
}