{
  "type": "module",
  "version": "0.1.1",
  "description": "A fast URLPattern router",
  "keywords": [
    "router",
    "url-pattern",
    "regexp"
  ],
  "repository": "mapljs/pattern-router",
  "exports": {
    ".": "./index.mjs",
    "./*": "./*.mjs"
  },
  "scripts": {
    "fmt": "oxfmt",
    "test": "node --test tests/**/*.test.mts",
    "build": "node scripts/src/build.mts",
    "pkg-stats": "node scripts/src/pkg-stats.mts",
    "push-release": "node scripts/src/push-release.mts",
    "setup": "node scripts/src/setup.mts",
    "snap": "node scripts/src/snap.mts"
  },
  "devDependencies": {
    "@types/node": "^26.4.0",
    "oxc-minify": "^0.154.0",
    "oxc-transform": "^0.154.0",
    "oxfmt": "^0.73.0",
    "picocolors": "^1.1.1",
    "typescript": "^7.0.2",
    "@mapl/pattern-router": "link:dist"
  },
  "sideEffects": false
}